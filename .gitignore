# Legacy DLD-portal CSV exports (silently truncated — superseded by parquet)
transactions-*.csv
rents-*.csv

# Parquet snapshots — too large for GitHub; rebuild via scripts/dld_refresh.sh
data/*.parquet

# Raw DLD/DM downloads (multi-GB, regeneratable via dld_refresh.sh / dld_buildings_pull.sh)
data/raw/

# Intermediate JSON outputs (inlined into HTML at build time)
data/aggregates_intermediate/

# Python / OS junk
__pycache__/
.DS_Store

# khda_refresh.sh log (cron-friendly target inside data/)
data/.khda_refresh.log

# OSM Buildings pipeline — raw/intermediate data (rebuilt by scripts/osm_buildings_pull.py + build_buildings_map.py)
data/buildings_geo.json
data/osm_buildings.json

# Local scratch — OAuth client secrets, DB backups, etc. Never commit.
tails/

# Reddit outreach skill state (seen/replied post tracking — runtime, not data)
data/.reddit_outreach/

# LinkedIn outreach skill state (replied-comment pacing log — runtime, not data)
data/.linkedin_outreach/

# LinkedIn agent-leads skill state (found/contacted agent tracking — runtime, not data)
data/.linkedin_agent_leads/

# Generated site pages — published by scripts/deploy.sh to the gh-pages branch, never committed to main
/en/
/ru/
/ar/
/hi/
/zh/
/buildings/
/app/
/sales/*/
!/sales/data/
/rents/*/
!/rents/data/

# Full OSM footprint dump (osm_all_footprints_pull.py, ~50-100 MB)
data/osm_all_footprints.json
